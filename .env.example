# Secrets — never commit this file. Copy to .env and fill in.

# Telegram alerting (create a bot via @BotFather, get chat id via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# RPC endpoint secrets referenced from argus.config.ts as ${VAR_NAME}
# Example: RPC_ETH_MAINNET=wss://mainnet.infura.io/ws/v3/<key>
RPC_ETH_MAINNET=

# Optional historical providers
ETHERSCAN_API_KEY=
BIGQUERY_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional dashboard/API authentication. When set, send either:
# Authorization: Bearer <token>
# or Basic credentials with the token as the password.
ARGUS_DASHBOARD_TOKEN=

# Optional logger threshold: debug | info | warn | error
ARGUS_LOG_LEVEL=info
