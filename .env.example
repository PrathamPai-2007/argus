# Secrets — never commit this file. Copy to .env and fill in what you have.
# Everything is optional: keyless public endpoints are configured as fallbacks.

# Telegram alerts (create a bot via @BotFather; get your chat id via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Wallet funder lookups (clustering). Etherscan is free for Ethereum;
# Base needs a free Blockscout PRO key (Etherscan's Base access is paid).
ETHERSCAN_API_KEY=
BLOCKSCOUT_API_KEY=

# Preferred RPC endpoints, tried before the public ones in argus.config.ts.
RPC_ETH_HTTP=
RPC_ETH_WS=
RPC_BASE_HTTP=
RPC_BASE_WS=

# Dashboard auth. When set, the dashboard asks for this token once and keeps
# a session cookie; API clients may send "Authorization: Bearer <token>".
ARGUS_DASHBOARD_TOKEN=

# Logger threshold: debug | info | warn | error
ARGUS_LOG_LEVEL=info
